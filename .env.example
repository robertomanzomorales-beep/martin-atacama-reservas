# Copie este archivo a .env.local. Nunca publique las credenciales.
APP_URL=http://localhost:3000
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Local: deje DATABASE_URL vacío; se crea data/reservas.db.
# Producción: base libSQL remota y persistente (por ejemplo libsql://...).
# También acepta TURSO_DATABASE_URL y TURSO_AUTH_TOKEN.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

BOOKING_EMAIL=contacto@transferatacamachile.cl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Agregar cuando Martín habilite Flow. Primero sandbox; luego producción.
FLOW_ENV=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
